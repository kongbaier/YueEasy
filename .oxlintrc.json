{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "style": "off",
    "perf": "warn",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "no-shadow": "off",
    "no-unused-vars": "warn",
    "prefer-const": "warn",
    "unicorn/filename-case": "off",
    "react/react-compiler": "error",
    "react/react-in-jsx-scope": "off",
    "react/no-unstable-nested-components": [
      "warn",
      {
        "allowAsProps": true
      }
    ],
    "typescript/consistent-type-imports": [
      "warn",
      { "fixStyle": "separate-type-imports" }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/features/**/*.tsx",
        "src/pages/**/*.tsx",
        "src/app/**/*.tsx"
      ],
      "rules": {
        "unicorn/filename-case": ["warn", { "cases": { "pascalCase": true } }]
      }
    },
    {
      "files": ["src/shared/**/*.tsx"],
      "excludeFiles": ["src/shared/ui/*.tsx"],
      "rules": {
        "unicorn/filename-case": ["warn", { "cases": { "pascalCase": true } }]
      }
    },
    {
      "files": ["src/shared/ui/*.tsx"],
      "rules": {
        "unicorn/filename-case": ["warn", { "cases": { "kebabCase": true } }]
      }
    },
    {
      "files": ["src/**/*.ts"],
      "excludeFiles": ["*.d.ts"],
      "rules": {
        "unicorn/filename-case": [
          "warn",
          { "cases": { "camelCase": true, "pascalCase": true } }
        ]
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19.0.0"
    }
  },
  "ignorePatterns": ["dist/", "build/", "node_modules/", "src-tauri/"]
}
