{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YueEasy",
  "version": "0.1.8",
  "identifier": "com.kongbai.yueeasy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "乐易",
        "width": 1280,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=MediaSessionService,msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMTcxQTNBNTk2MDYzNDAKUldSQVkyQlpPaG9YWEt3YlNvcDJzT2ZyTGE2bUprMzZzaFp4WStwSUZ6VTltK1JKcUpIU0k0TzYK",
      "endpoints": [
        "https://github.com/kongbaier/YueEasy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "minimumWebview2Version": null,
      "nsis": {
        "languages": ["SimpChinese", "English"]
      },
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
